{"cells":[{"cell_type":"markdown","metadata":{"id":"Wy447M0ZCeht"},"source":["2.2. DATOS METEOROLOGICOS (API AEMET)"]},{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":2003,"status":"ok","timestamp":1787725548079,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"},"user_tz":-60},"id":"vXn2YORGNZ4G","outputId":"f75618d2-df22-4b34-d145-aa1437421e3e"},"outputs":[{"output_type":"stream","name":"stdout","text":["Iniciando conexión con AEMET OpenData...\n","\n","¡Éxito! Hay 31 registros.\n","        fecha  tmax hrMedia velmedia racha dir\n","0  2023-08-01  29,9      59      6,1  17,5  03\n","1  2023-08-02  28,2      65      5,6  16,4  32\n","2  2023-08-03  28,5      67      6,7  17,5  30\n","3  2023-08-04  27,3      74      5,6  15,8  34\n","4  2023-08-05  27,1      62      4,7  16,1  32\n"]}],"source":["\"\"\"\n","Módulo para la extracción de datos climatológicos históricos a través de la API\n","AEMET OpenData.\n","\"\"\"\n","import json\n","from datetime import datetime\n","import requests\n","import pandas as pd\n","\n","\n","# Clave alfanumérica para entrar en la API AEMET\n","API_KEY = \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJqcmFtb3NtZW5kb3phM0BnbWFpbC5jb20iLCJ\\\n","qdGkiOiIyYTAyYWM0Ny1lZTZhLTQ3NDEtOWQ0Yi1mOTdmOGQ1OTIzZjIiLCJpc3MiOiJBRU1FVCIsIm\\\n","lhdCI6MTc4MTgxMTI5NSwidXNlcklkIjoiMmEwMmFjNDctZWU2YS00NzQxLTlkNGItZjk3ZjhkNTkyM\\\n","2YyIiwicm9sZSI6IiJ9.0T8q8cfY4ebvgsrJ_xZhUoBbsOXWNvBuPdMCmtl-UX4\"\n","\n","BASE_URL = \"https://opendata.aemet.es/opendata/api\"\n","ESTACION_PRUEBA = \"C329Z\"  # Estación de San Sebastián de La Gomera\n","\n","\n","def extraer_historico_aemet(fecha_ini: str, fecha_fin: str, estacion: str, api_key: str) -> pd.DataFrame:\n","    \"\"\"\n","    Extrae los valores climatológicos diarios de una estación meteorológica\n","    específica en un rango de fechas.\n","\n","    La API de AEMET funciona en dos pasos: primero solicita una URL de descarga\n","    temporal y luego extrae los datos de esa URL.\n","\n","    Args:\n","        fecha_ini (str): Fecha de inicio en formato 'YYYY-MM-DDTHH:MM:SSUTC'.\n","        fecha_fin (str): Fecha de fin en formato 'YYYY-MM-DDTHH:MM:SSUTC'.\n","        estacion (str): Indicativo alfanumérico de la estación de la AEMET.\n","        api_key (str): Clave de autorización del usuario.\n","\n","    Returns:\n","        pd.DataFrame: Tabla estructurada con los datos meteorológicos (temperatura,\n","                      humedad, viento, etc.). Devuelve un DataFrame vacío si falla.\n","    \"\"\"\n","\n","    # Endpoint según la documentación oficial\n","    endpoint = f\"/valores/climatologicos/diarios/datos/fechaini/{fecha_ini}/fechafin/{fecha_fin}/estacion/{estacion}\"\n","    url_peticion = BASE_URL + endpoint\n","\n","    # Configuración de acceso\n","    headers = {\n","        \"cache-control\": \"no-cache\",\n","        \"api_key\": api_key\n","    }\n","\n","    try:\n","        # Solicitamos la URL de descarga al servidor\n","        respuesta_inicial = requests.get(url_peticion, headers=headers)\n","        respuesta_inicial.raise_for_status()\n","\n","        datos_json = respuesta_inicial.json()\n","\n","        # Comprobación\n","        if datos_json.get(\"estado\") == 200:\n","            url_datos = datos_json.get(\"datos\")\n","\n","            # Extración los datos finales desde la URL temporal\n","            respuesta_datos = requests.get(url_datos)\n","            respuesta_datos.raise_for_status()\n","\n","            # JSON a DataFrame estructurado\n","            df_clima = pd.DataFrame(respuesta_datos.json())\n","            return df_clima\n","        else:\n","            print(f\"Error en la API: {datos_json.get('descripcion')}\")\n","            return pd.DataFrame()\n","\n","    except requests.exceptions.RequestException as e:\n","        print(f\"Fallo en la conexión HTTP: {e}\")\n","        return pd.DataFrame()\n","\n","\n","# PRUEBA\n","if __name__ == \"__main__\":\n","\n","    print(\"Iniciando conexión con AEMET OpenData...\")\n","\n","    # Ventana temporal de prueba (agosto-23)\n","    FECHA_INICIO = \"2023-08-01T00:00:00UTC\"\n","    FECHA_FIN = \"2023-08-31T23:59:59UTC\"\n","\n","    df_resultado = extraer_historico_aemet(\n","        fecha_ini=FECHA_INICIO, fecha_fin=FECHA_FIN,\n","        estacion=ESTACION_PRUEBA, api_key=API_KEY\n","        )\n","\n","    # Comprobación\n","    if not df_resultado.empty:\n","        print(f\"\\n¡Éxito! Hay {len(df_resultado)} registros.\")\n","\n","        # Mostramos variables clave: Fecha, Temperatura, Humedad, ...\n","        columnas_interes = ['fecha', 'tmax', 'hrMedia', 'velmedia', 'racha', 'dir']\n","\n","        # Filtramos las columnas\n","        columnas_disponibles = [col for col in columnas_interes if col in df_resultado.columns]\n","        print(df_resultado[columnas_disponibles].head())\n","    else:\n","        print(\"\\nNo se han podido recuperar los datos. Revisa los parámetros o la API Key.\")"]},{"cell_type":"markdown","metadata":{"id":"36cpBOLg0I-d"},"source":["Como vemos la salida muestra los valores decimales separados por coma y no con puntos y las fechas en un formato no convencional, asi que mejoraré el codigo."]},{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1599,"status":"ok","timestamp":1787725551709,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"},"user_tz":-60},"id":"xaM2hM9S03cl","outputId":"323a0210-c85f-42ca-dfca-980107e928ff"},"outputs":[{"output_type":"stream","name":"stdout","text":["Iniciando conexión con AEMET OpenData...\n","\n","¡Éxito! Hay 31 registros.\n","fecha       datetime64[ns]\n","tmax               float64\n","hrMedia              int64\n","velmedia           float64\n","racha              float64\n","dir                float64\n","dtype: object\n","       fecha  tmax  hrMedia  velmedia  racha   dir\n","0 2023-08-01  29.9       59       6.1   17.5   3.0\n","1 2023-08-02  28.2       65       5.6   16.4  32.0\n","2 2023-08-03  28.5       67       6.7   17.5  30.0\n","3 2023-08-04  27.3       74       5.6   15.8  34.0\n","4 2023-08-05  27.1       62       4.7   16.1  32.0\n"]}],"source":["def limpiar_datos_aemet(df_crudo: pd.DataFrame) -> pd.DataFrame:\n","    \"\"\"\n","    Limpia y formatea el DataFrame crudo obtenido de la API de AEMET.\n","    Convierte los separadores decimales de coma a punto y fuerza el formato numérico.\n","\n","    Args:\n","        df_crudo (pd.DataFrame): Datos meteorológicos sin procesar (texto).\n","\n","    Returns:\n","        pd.DataFrame: Tabla con tipos numéricos estructurados para Machine Learning.\n","    \"\"\"\n","    df_limpio = df_crudo.copy()\n","\n","    columnas_numericas = [\n","        'tmed', 'prec', 'tmin', 'tmax', 'dir', 'velmedia',\n","        'racha', 'sol', 'presMax', 'presMin', 'hrMedia', 'hrMax', 'hrMin'\n","    ]\n","\n","    for col in columnas_numericas:\n","        if col in df_limpio.columns:\n","            # errors='coerce' fuerza la conversión. Si encuentra un dato corrupto, pone NaN\n","            df_limpio[col] = df_limpio[col].astype(str).str.replace(',', '.')\n","            df_limpio[col] = pd.to_numeric(df_limpio[col], errors='coerce')\n","\n","    # Aseguramos que la columna fecha sea un objeto de tiempo\n","    if 'fecha' in df_limpio.columns:\n","        df_limpio['fecha'] = pd.to_datetime(df_limpio['fecha'])\n","\n","    return df_limpio\n","\n","def extraer_historico_aemet(fecha_ini: str, fecha_fin: str, estacion: str, api_key: str) -> pd.DataFrame:\n","    \"\"\"\n","    Extrae los valores climatológicos diarios de una estación meteorológica\n","    específica en un rango de fechas.\n","\n","    La API de AEMET funciona en dos pasos: primero solicita una URL de descarga\n","    temporal y luego extrae los datos de esa URL.\n","\n","    Args:\n","        fecha_ini (str): Fecha de inicio en formato 'YYYY-MM-DDTHH:MM:SSUTC'.\n","        fecha_fin (str): Fecha de fin en formato 'YYYY-MM-DDTHH:MM:SSUTC'.\n","        estacion (str): Indicativo alfanumérico de la estación de la AEMET.\n","        api_key (str): Clave de autorización del usuario.\n","\n","    Returns:\n","        pd.DataFrame: Tabla estructurada con los datos meteorológicos (temperatura,\n","                      humedad, viento, etc.). Devuelve un DataFrame vacío si falla.\n","    \"\"\"\n","\n","    # Endpoint según la documentación oficial\n","    endpoint = f\"/valores/climatologicos/diarios/datos/fechaini/{fecha_ini}/fechafin/{fecha_fin}/estacion/{estacion}\"\n","    url_peticion = BASE_URL + endpoint\n","\n","    # Configuración de acceso\n","    headers = {\n","        \"cache-control\": \"no-cache\",\n","        \"api_key\": api_key\n","    }\n","\n","    try:\n","        # Solicitamos la URL de descarga al servidor\n","        respuesta_inicial = requests.get(url_peticion, headers=headers)\n","        respuesta_inicial.raise_for_status()\n","\n","        datos_json = respuesta_inicial.json()\n","\n","        # Comprobación\n","        if datos_json.get(\"estado\") == 200:\n","            url_datos = datos_json.get(\"datos\")\n","\n","            # Extración los datos finales desde la URL temporal\n","            respuesta_datos = requests.get(url_datos)\n","            respuesta_datos.raise_for_status()\n","\n","            # JSON a DataFrame estructurado\n","            df_clima = pd.DataFrame(respuesta_datos.json())\n","            df_clima = limpiar_datos_aemet(df_clima)\n","            return df_clima\n","        else:\n","            print(f\"Error en la API: {datos_json.get('descripcion')}\")\n","            return pd.DataFrame()\n","\n","    except requests.exceptions.RequestException as e:\n","        print(f\"Fallo en la conexión HTTP: {e}\")\n","        return pd.DataFrame()\n","\n","# PRUEBA\n","if __name__ == \"__main__\":\n","\n","    print(\"Iniciando conexión con AEMET OpenData...\")\n","\n","    # Ventana temporal de prueba (agosto-23)\n","    FECHA_INICIO = \"2023-08-01T00:00:00UTC\"\n","    FECHA_FIN = \"2023-08-31T23:59:59UTC\"\n","\n","    df_resultado = extraer_historico_aemet(\n","        fecha_ini=FECHA_INICIO, fecha_fin=FECHA_FIN,\n","        estacion=ESTACION_PRUEBA, api_key=API_KEY\n","        )\n","\n","    # Comprobación\n","    if not df_resultado.empty:\n","        print(f\"\\n¡Éxito! Hay {len(df_resultado)} registros.\")\n","\n","        columnas_interes = ['fecha', 'tmax', 'hrMedia', 'velmedia', 'racha', 'dir']\n","\n","        # Filtramos las columnas\n","        columnas_disponibles = [col for col in columnas_interes if col in df_resultado.columns]\n","        print(df_resultado[columnas_disponibles].dtypes)\n","        print(df_resultado[columnas_disponibles].head())\n","    else:\n","        print(\"\\nNo se han podido recuperar los datos. Revisa los parámetros o la API Key.\")"]},{"cell_type":"markdown","metadata":{"id":"pUwGWCIuCrqP"},"source":["2.1. IMAGENES MULTIESPECTRALES (COPERNICUS/SENTINEL-2)"]},{"cell_type":"code","execution_count":3,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"8ZGBvtFMC1jj","outputId":"5d200f38-3830-4bbb-a460-51b0acdbef34","executionInfo":{"status":"ok","timestamp":1787725556047,"user_tz":-60,"elapsed":3310,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["Solicitando credenciales a Google Colab...\n","Vinculando credenciales con Earth Engine...\n","¡Completado con éxito!\n","\n","Lanzando consulta espacial de prueba a los servidores de Google...\n","\n","¡Éxito! Se han encontrado 6 imágenes satelitales\n"]}],"source":["\"\"\"\n","Módulo para la conexión y extracción preliminar de imágenes\n","satelitales multiespectrales mediante Google Earth Engine.\n","\"\"\"\n","\n","import ee\n","\n","# Valor del ID de mi proyecto de Google Cloud\n","PROYECTO_GCP = \"tfm-bbdd-499813\"\n","\n","\n","def inicializar_gee(proyecto: str) -> None:\n","    \"\"\"\n","    Autentica el usuario e inicializa la sesión de Google Earth Engine.\n","\n","    Al ejecutar en Google Colab, se abrirá una ventana emergente\n","    para conceder permisos a la cuenta de Google.\n","\n","    Args:\n","        proyecto (str): Identificador del proyecto en Google Cloud.\n","    \"\"\"\n","    try:\n","        print(\"Solicitando credenciales a Google Colab...\")\n","        from google.colab import auth\n","        auth.authenticate_user()\n","\n","        print(\"Vinculando credenciales con Earth Engine...\")\n","        import ee\n","        ee.Authenticate()\n","        ee.Initialize(project=proyecto)\n","\n","        print(\"¡Completado con éxito!\")\n","    except Exception as e:\n","        print(f\"Error al inicializar Google Earth Engine: {e}\")\n","\n","\n","if __name__ == \"__main__\":\n","\n","    # Ejecutamos la autenticación\n","    inicializar_gee(PROYECTO_GCP)\n","\n","    print(\"\\nLanzando consulta espacial de prueba a los servidores de Google...\")\n","\n","    try:\n","        # Definimos un punto geométrico de prueba (San Sebastián de La Gomera)\n","        # Formato [Longitud, Latitud]\n","        punto_prueba = ee.Geometry.Point([-17.113, 28.091])\n","\n","        # Filtramos la colección de Sentinel-2 (Reflectancia de Superficie)\n","        coleccion_s2 = (\n","            ee.ImageCollection(\"COPERNICUS/S2_SR_HARMONIZED\")\n","            .filterBounds(punto_prueba)\n","            .filterDate('2023-08-01', '2023-08-31')\n","        )\n","\n","        # Solicitamos la información al servidor con getInfo()\n","        numero_imagenes = coleccion_s2.size().getInfo()\n","        print(f\"\\n¡Éxito! Se han encontrado {numero_imagenes} imágenes satelitales\")\n","\n","    except Exception as e:\n","        print(f\"\\nFallo en la consulta a la colección Sentinel-2: {e}\")"]},{"cell_type":"markdown","metadata":{"id":"xToHOtvPdTHn"},"source":["Ahora que hemos probado con éxito que podemos descargar datos meteo de cualquier estación de la AEMET, y también obtener las correspondiente imágenes satelitales de copernicus asociadas a las coordenadas de dicha estación, el siguiente paso será obtener el catálogo entero de estaciones meteo de la AEMET en Canarias."]},{"cell_type":"code","execution_count":4,"metadata":{"id":"wh3diLK3d9fV","colab":{"base_uri":"https://localhost:8080/"},"outputId":"ea1a8879-c59b-46da-e6ff-aca40a46160e","executionInfo":{"status":"ok","timestamp":1787725558412,"user_tz":-60,"elapsed":2347,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}}},"outputs":[{"output_type":"stream","name":"stdout","text":["Conectando con AEMET para extraer el catálogo...\n","\n","¡Catálogo extraído con éxito! Se han detectado 58 estaciones en Canarias.\n","\n","Muestra de las estaciones y sus coordenadas convertidas:\n","  indicativo                nombre altitud  latitud_dec  longitud_dec\n","0      C018J                  TÍAS     376    28.969722    -13.690278\n","1      C019V    YAIZA PLAYA BLANCA       6    28.858889    -13.835000\n","2      C029O  LANZAROTE AEROPUERTO      14    28.951944    -13.600278\n","3      C038N                 HARÍA     277    29.143611    -13.489167\n","4      C048W                TINAJO     275    29.042500    -13.680833\n","Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","\n","Catálogo guardado físicamente en: /content/drive/MyDrive/Master BigData IA/TFM/catalogo_estaciones_canarias.csv\n"]}],"source":["\"\"\"\n","Módulo para la extracción y transformación del catálogo\n","de estaciones meteorológicas de AEMET OpenData en Canarias.\n","\"\"\"\n","import os\n","\n","# Constantes Globales\n","API_KEY = \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJqcmFtb3NtZW5kb3phM0BnbWFpbC5jb20iLCJ\\\n","qdGkiOiIyYTAyYWM0Ny1lZTZhLTQ3NDEtOWQ0Yi1mOTdmOGQ1OTIzZjIiLCJpc3MiOiJBRU1FVCIsIm\\\n","lhdCI6MTc4MTgxMTI5NSwidXNlcklkIjoiMmEwMmFjNDctZWU2YS00NzQxLTlkNGItZjk3ZjhkNTkyM\\\n","2YyIiwicm9sZSI6IiJ9.0T8q8cfY4ebvgsrJ_xZhUoBbsOXWNvBuPdMCmtl-UX4\"\n","BASE_URL = \"https://opendata.aemet.es/opendata/api\"\n","\n","\n","def convertir_coordenadas_aemet(coord_str: str) -> float:\n","    \"\"\"\n","    Convierte las coordenadas sexagesimales concatenadas de AEMET\n","    (ej. '280523N') a formato decimal estándar.\n","\n","    Args:\n","        coord_str (str): Cadena de texto con la coordenada cruda.\n","\n","    Returns:\n","        float: Coordenada en formato decimal (negativo para Sur y Oeste).\n","    \"\"\"\n","    if pd.isna(coord_str):\n","        return None\n","\n","    coord_str = str(coord_str).strip()\n","    direccion = coord_str[-1]\n","    numeros = coord_str[:-1]\n","\n","    try:\n","        # Segundos, Minutos, Grados\n","        segundos = float(numeros[-2:])\n","        minutos = float(numeros[-4:-2])\n","        grados = float(numeros[:-4])\n","\n","        # Conversión a decimal\n","        decimal = grados + (minutos / 60) + (segundos / 3600)\n","\n","        # Ajuste de signo según el hemisferio\n","        if direccion in ['S', 'W']:\n","            decimal = -decimal\n","\n","        return round(decimal, 6)\n","    except ValueError:\n","        return None\n","\n","\n","def extraer_catalogo_canarias(api_key: str) -> pd.DataFrame:\n","    \"\"\"\n","    Extrae el inventario de todas las estaciones de la AEMET y filtra\n","    las pertenecientes a Canarias.\n","\n","    Args:\n","        api_key (str): Clave de autorización del usuario.\n","\n","    Returns:\n","        pd.DataFrame: Catálogo limpio de estaciones canarias con coordenadas decimales.\n","    \"\"\"\n","    endpoint = \"/valores/climatologicos/inventarioestaciones/todasestaciones\"\n","    url_peticion = BASE_URL + endpoint\n","\n","    headers = {\n","        \"cache-control\": \"no-cache\",\n","        \"api_key\": api_key\n","    }\n","\n","    try:\n","        respuesta_inicial = requests.get(url_peticion, headers=headers)\n","        respuesta_inicial.raise_for_status()\n","        datos_json = respuesta_inicial.json()\n","\n","        if datos_json.get(\"estado\") == 200:\n","            url_datos = datos_json.get(\"datos\")\n","\n","            # Descargamos los datos\n","            respuesta_datos = requests.get(url_datos)\n","            respuesta_datos.raise_for_status()\n","\n","            # Transformación a DataFrame\n","            df_estaciones = pd.DataFrame(respuesta_datos.json())\n","\n","            # Filtro: Solo Canarias (Provincias de STA. CRUZ DE TENERIFE y LAS PALMAS)\n","            provincias_canarias = ['STA. CRUZ DE TENERIFE', 'LAS PALMAS']\n","            df_canarias = df_estaciones[df_estaciones['provincia'].isin(provincias_canarias)].copy()\n","\n","            # Filtro: Seleccionamos solo las columnas de interés\n","            columnas_interes = ['indicativo', 'nombre', 'provincia', 'altitud', 'latitud', 'longitud']\n","            df_canarias = df_canarias[columnas_interes]\n","\n","            # Transformación de las coordenadas al formato decimal\n","            df_canarias['latitud_dec'] = df_canarias['latitud'].apply(convertir_coordenadas_aemet)\n","            df_canarias['longitud_dec'] = df_canarias['longitud'].apply(convertir_coordenadas_aemet)\n","\n","            # Reordenamos el índice para que sea limpio\n","            df_canarias.reset_index(drop=True, inplace=True)\n","\n","            return df_canarias\n","        else:\n","            print(f\"Error en la API: {datos_json.get('descripcion')}\")\n","            return pd.DataFrame()\n","\n","    except requests.exceptions.RequestException as e:\n","        print(f\"Fallo en la conexión HTTP: {e}\")\n","        return pd.DataFrame()\n","\n","\n","# PRUEBA\n","if __name__ == \"__main__\":\n","\n","    print(\"Conectando con AEMET para extraer el catálogo...\")\n","\n","    catalogo_canarias = extraer_catalogo_canarias(API_KEY)\n","\n","    if not catalogo_canarias.empty:\n","        print(f\"\\n¡Catálogo extraído con éxito! Se han detectado {len(catalogo_canarias)} estaciones en Canarias.\")\n","\n","        # Mostramos una muestra\n","        print(\"\\nMuestra de las estaciones y sus coordenadas convertidas:\")\n","        print(catalogo_canarias[['indicativo', 'nombre', 'altitud', 'latitud_dec', 'longitud_dec']].head())\n","\n","        from google.colab import drive\n","        drive.mount('/content/drive')\n","\n","        # Exporto el archivo de estaciones al Drive\n","        ruta_carpeta = '/content/drive/MyDrive/Master BigData IA/TFM'\n","        ruta_archivo = os.path.join(ruta_carpeta, \"catalogo_estaciones_canarias.csv\")\n","        catalogo_canarias.to_csv(ruta_archivo, index=False, encoding='utf-8-sig')\n","        print(f\"\\nCatálogo guardado físicamente en: {ruta_archivo}\")\n","\n","    else:\n","        print(\"\\nFallo en la extracción del catálogo.\")"]},{"cell_type":"markdown","metadata":{"id":"1ayBTYBTjOKh"},"source":["Ahora que tenemos el catalogo de estaciones y sus respectivos indicativos y coordenadas, lo siguiente será obtener una lista de fechas en las que los satélites de la constelación Sentinel-2 pasaron por encima de Canarias desde 2017 hasta el día de hoy. De esta manera, solo nos quedaremos los datos meteo de las estaciones AEMET los días en los que tenemos imagen satelital."]},{"cell_type":"code","execution_count":5,"metadata":{"id":"cavCM-P0kN0p","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1787725570874,"user_tz":-60,"elapsed":11052,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}},"outputId":"22dab2bf-0fdf-4ce8-d653-ff1e83214303"},"outputs":[{"output_type":"stream","name":"stdout","text":["Solicitando credenciales a Google Colab...\n","Vinculando credenciales con Earth Engine...\n","¡Completado con éxito!\n","\n","¡Éxito! Se han detectado 2027 días únicos con captura de imágenes.\n","\n","Muestra de las primeras y últimas fechas registradas:\n","        fecha\n","0  2017-03-29\n","1  2017-04-01\n","2  2017-04-03\n","...\n","           fecha\n","2024  2026-07-25\n","2025  2026-07-26\n","2026  2026-07-28\n","\n","Guardando el calendario en Google Drive...\n","Drive already mounted at /content/drive; to attempt to forcibly remount, call drive.mount(\"/content/drive\", force_remount=True).\n","Calendario guardado físicamente en: /content/drive/MyDrive/Master BigData IA/TFM/calendario_sentinel2_canarias.csv\n"]}],"source":["\"\"\"\n","Módulo para la extracción del calendario de sobrevuelos de la constelación\n","Sentinel-2 sobre las Islas Canarias.\n","\"\"\"\n","\n","from google.colab import auth\n","\n","# Constantes Globales\n","PROYECTO_GCP = \"tfm-bbdd-499813\"\n","FECHA_INICIO = \"2017-03-28\"\n","FECHA_FIN = \"2026-07-30\"\n","\n","# Box de Canarias\n","BBOX_CANARIAS = [-18.5, 27.5, -13.0, 29.5]\n","\n","def obtener_calendario_satelite(fecha_ini: str, fecha_fin: str, bbox: list) -> list:\n","    \"\"\"\n","    Consulta el catálogo de Earth Engine para obtener una lista de fechas\n","    únicas en las que Sentinel-2 capturó imágenes sobre la zona de estudio.\n","\n","    Args:\n","        fecha_ini (str): Fecha inicial en formato 'YYYY-MM-DD'.\n","        fecha_fin (str): Fecha final en formato 'YYYY-MM-DD'.\n","        bbox (list): Coordenadas de la caja delimitadora.\n","\n","    Returns:\n","        list: Lista de cadenas con las fechas únicas ordenadas cronológicamente.\n","    \"\"\"\n","    zona_estudio = ee.Geometry.Rectangle(bbox)\n","\n","    coleccion = (\n","        ee.ImageCollection(\"COPERNICUS/S2_SR_HARMONIZED\")\n","        .filterBounds(zona_estudio)\n","        .filterDate(fecha_ini, fecha_fin)\n","    )\n","\n","    # Creamos una función interna que se ejecuta en los servidores de Google para cada imagen\n","    def extraer_fecha(imagen):\n","        fecha_formateada = imagen.date().format('YYYY-MM-dd')\n","        return ee.Feature(None, {'fecha': fecha_formateada})\n","\n","    # Mapeamos la función sobre toda la colección\n","    coleccion_fechas = coleccion.map(extraer_fecha)\n","\n","    # Agrupamos todas las fechas, eliminamos los duplicados y ordenamos\n","    lista_fechas_unicas = coleccion_fechas.aggregate_array('fecha').distinct().sort()\n","\n","    return lista_fechas_unicas.getInfo()\n","\n","\n","# PRUEBA\n","\n","if __name__ == \"__main__\":\n","\n","    inicializar_gee(PROYECTO_GCP)\n","\n","    fechas_satelite = obtener_calendario_satelite(FECHA_INICIO, FECHA_FIN, BBOX_CANARIAS)\n","\n","    if fechas_satelite:\n","        print(f\"\\n¡Éxito! Se han detectado {len(fechas_satelite)} días únicos con captura de imágenes.\")\n","\n","        # Convertimos la lista a un dataframe de pandas\n","        df_calendario = pd.DataFrame(fechas_satelite, columns=['fecha'])\n","\n","        print(\"\\nMuestra de las primeras y últimas fechas registradas:\")\n","        print(df_calendario.head(3))\n","        print(\"...\")\n","        print(df_calendario.tail(3))\n","\n","        # Guardado en Google Drive\n","        print(\"\\nGuardando el calendario en Google Drive...\")\n","        from google.colab import drive\n","        drive.mount('/content/drive')\n","\n","        ruta_carpeta = '/content/drive/MyDrive/Master BigData IA/TFM'\n","        os.makedirs(ruta_carpeta, exist_ok=True)\n","        ruta_archivo = os.path.join(ruta_carpeta, \"calendario_sentinel2_canarias.csv\")\n","\n","        df_calendario.to_csv(ruta_archivo, index=False, encoding='utf-8-sig')\n","        print(f\"Calendario guardado físicamente en: {ruta_archivo}\")\n","\n","    else:\n","        print(\"\\nFallo en la generación del calendario.\")"]},{"cell_type":"markdown","metadata":{"id":"bRDfQjnHocrf"},"source":["Otro problema que surge ahora es que las imagenes satelitales de Sentinel-2 tienen un ancho de barrido de unos 290 km, mientras que Canarias tiene unos 500 km de Oeste a Este. Por lo tanto, puede que un dia haya imagen satelital pero solo de las islas de Tenerife y La Gomera, no del resto. Por lo tanto, plantearemos lo siguiente:\n","\n","1) Crearemos un código que cargue una de las 58 estaciones del catálogo (ej. San Sebastián de La Gomera).\n","\n","2) Le pasamos a Earth Engine las coordenadas exactas de la estación (Long: -17.113, Lat: 28.091). \"Dime en qué fechas exactas Sentinel-2 fotografió este punto concreto\".\n","\n","3) Earth Engine nos devolverá un sub-calendario (por ejemplo, solo 700 días, ya que descarta los días que pasó por encima de Lanzarote).\n","\n","4) El código va a la AEMET, descarga el clima anual de esa estación, y filtra cruzándolo con su sub-calendario de 700 días.\n","\n","5) Se repite el proceso para la siguiente estación.\n","\n","Con este flujo, aseguramos matemáticamente que cada fila de clima que guardemos en el CSV final tendrá siempre una imagen satelital asociada esperándola."]},{"cell_type":"code","execution_count":6,"metadata":{"id":"7BBjRDtjtVa7","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1787725574326,"user_tz":-60,"elapsed":3444,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}},"outputId":"63b480d1-461c-4626-bd5f-5945bec18af5"},"outputs":[{"output_type":"stream","name":"stdout","text":["\n","¡Éxito! Se han detectado 690 pasadas sobre La Gomera.\n","['2017-04-21', '2017-05-01', '2017-05-11', '2017-05-21', '2017-05-31']\n","...\n","['2026-07-15', '2026-07-18', '2026-07-23', '2026-07-25', '2026-07-28']\n"]}],"source":["\"\"\"\n","Módulo para calcular el calendario individualizado de capturas satelitales\n","para unas estación meteorológica específica.\n","\"\"\"\n","\n","# Asumimos que 'ee' y 'pd' ya están importados en la sesión de Colab\n","# y que la conexión inicializar_gee() está activa.\n","\n","FECHA_INICIO = \"2017-03-28\"\n","FECHA_FIN = \"2026-07-30\"\n","\n","\n","def calendario_por_estacion(lat: float, lon: float) -> list:\n","    \"\"\"\n","    Consulta a Google Earth Engine las fechas exactas en las que\n","    Sentinel-2 sobrevoló unas coordenadas concretas.\n","\n","    Args:\n","        lat (float): Latitud de la estación meteorológica en formato decimal.\n","        lon (float): Longitud de la estación meteorológica en formato decimal.\n","\n","    Returns:\n","        list: Fechas únicas (YYYY-MM-DD) en las que el satélite capturó ese punto.\n","    \"\"\"\n","    # Definimos el punto exacto de la estación\n","    punto_estacion = ee.Geometry.Point([lon, lat])\n","\n","    # Filtramos la colección satelital para que solo busque intersecciones con ese punto\n","    coleccion_punto = (\n","        ee.ImageCollection(\"COPERNICUS/S2_SR_HARMONIZED\")\n","        .filterBounds(punto_estacion)\n","        .filterDate(FECHA_INICIO, FECHA_FIN)\n","    )\n","\n","    # Extraemos la fecha de cada imagen que tocó el punto\n","    def extraer_fecha(imagen):\n","        fecha_formateada = imagen.date().format('YYYY-MM-dd')\n","        return ee.Feature(None, {'fecha': fecha_formateada})\n","\n","    fechas_mapeadas = coleccion_punto.map(extraer_fecha)\n","\n","    fechas_unicas = fechas_mapeadas.aggregate_array('fecha').distinct().sort()\n","\n","    return fechas_unicas.getInfo()\n","\n","\n","# PRUEBA:\n","if __name__ == \"__main__\":\n","\n","    # Usaremos las coordenadas de la estación de San Sebastián de La Gomera\n","    LAT_PRUEBA = 28.089722\n","    LON_PRUEBA = -17.111389\n","\n","    try:\n","        calendario_gomera = calendario_por_estacion(LAT_PRUEBA, LON_PRUEBA)\n","\n","        if calendario_gomera:\n","            print(f\"\\n¡Éxito! Se han detectado {len(calendario_gomera)} pasadas sobre La Gomera.\")\n","            print(calendario_gomera[:5])\n","            print(\"...\")\n","            print(calendario_gomera[-5:])\n","        else:\n","            print(\"\\nNo se encontraron imágenes para estas coordenadas.\")\n","\n","    except Exception as e:\n","        print(f\"\\nFallo en la comunicación con Earth Engine: {e}\")"]},{"cell_type":"markdown","metadata":{"id":"UrgMKlcKvxdp"},"source":["Como vemos para la estación de San Sebastián de La Gomera no hubo 2027 pasadas, sino 690. Ahora, finalizaremos la construccion de nuestro dataset definitivo con un script que recoja los datos asociados a una estación meteo solo si ese día hubo imagen satelital. De esta manera, tendremos el indicativo de la estación, el nombre, la fecha, coordenadas y las variables meteorológicas de interés."]},{"cell_type":"code","execution_count":7,"metadata":{"id":"jQglQ0AQHf9y","executionInfo":{"status":"ok","timestamp":1787725574351,"user_tz":-60,"elapsed":15,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}}},"outputs":[],"source":["\"\"\"\n","Construcción del dataset final\n","Cruza el catálogo de estaciones con los calendarios satelitales individuales\n","y extrae las 3 variables de interés para el riesgo de incendio.\n","\"\"\"\n","\n","import time\n","from tqdm.notebook import tqdm\n","\n","API_KEY = \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJqcmFtb3NtZW5kb3phM0BnbWFpbC5jb20iLCJ\\\n","qdGkiOiIyYTAyYWM0Ny1lZTZhLTQ3NDEtOWQ0Yi1mOTdmOGQ1OTIzZjIiLCJpc3MiOiJBRU1FVCIsIm\\\n","lhdCI6MTc4MTgxMTI5NSwidXNlcklkIjoiMmEwMmFjNDctZWU2YS00NzQxLTlkNGItZjk3ZjhkNTkyM\\\n","2YyIiwicm9sZSI6IiJ9.0T8q8cfY4ebvgsrJ_xZhUoBbsOXWNvBuPdMCmtl-UX4\"\n","BASE_URL = \"https://opendata.aemet.es/opendata/api\"\n","ANIO_INICIO = 2017\n","ANIO_FIN = 2026\n","\n","def extraer_aemet_semestral(estacion: str, fecha_ini: str, fecha_fin: str) -> pd.DataFrame:\n","    \"\"\"\n","    Descarga un bloque semestral de datos para una estación\n","    \"\"\"\n","\n","    endpoint = f\"/valores/climatologicos/diarios/datos/fechaini/{fecha_ini}/fechafin/{fecha_fin}/estacion/{estacion}\"\n","    headers = {\"cache-control\": \"no-cache\", \"api_key\": API_KEY}\n","\n","    try:\n","        resp = requests.get(BASE_URL + endpoint, headers=headers)\n","        if resp.status_code == 200:\n","            datos_json = resp.json()\n","            if datos_json.get(\"estado\") == 200:\n","                url_datos = datos_json.get(\"datos\")\n","                datos_reales = requests.get(url_datos).json()\n","                return pd.DataFrame(datos_reales)\n","    except Exception as e:\n","        pass\n","    return pd.DataFrame()\n","\n","def extraer_anio_completo(estacion: str, anio: int) -> pd.DataFrame:\n","    \"\"\"\n","    Divide un año en dos bloques semestrales para respetar el límite de descarga de la AEMET\n","    \"\"\"\n","\n","    df_anio = pd.DataFrame()\n","    # Semestre 1\n","    df_s1 = extraer_aemet_semestral(estacion, f\"{anio}-01-01T00:00:00UTC\", f\"{anio}-06-30T23:59:59UTC\")\n","    time.sleep(0.3)\n","    # Semestre 2\n","    df_s2 = extraer_aemet_semestral(estacion, f\"{anio}-07-01T00:00:00UTC\", f\"{anio}-12-31T23:59:59UTC\")\n","    time.sleep(0.3)\n","\n","    if not df_s1.empty:\n","        df_anio = pd.concat([df_anio, df_s1], ignore_index=True)\n","    if not df_s2.empty:\n","        df_anio = pd.concat([df_anio, df_s2], ignore_index=True)\n","\n","    return df_anio\n","\n","def limpiar_aemet_reducido(df_crudo: pd.DataFrame) -> pd.DataFrame:\n","    \"\"\"Aplica la limpieza solo a las 3 variables de interes\"\"\"\n","    df_limpio = df_crudo.copy()\n","    columnas_num = ['tmax', 'hrMedia', 'velmedia']\n","\n","    for col in columnas_num:\n","        if col in df_limpio.columns:\n","            df_limpio[col] = df_limpio[col].astype(str).str.replace(',', '.')\n","            df_limpio[col] = pd.to_numeric(df_limpio[col], errors='coerce')\n","\n","    if 'fecha' in df_limpio.columns:\n","        df_limpio['fecha'] = pd.to_datetime(df_limpio['fecha']).dt.strftime('%Y-%m-%d')\n","\n","    return df_limpio\n","\n","\n"]},{"cell_type":"code","execution_count":9,"metadata":{"id":"pgydAu2llOnQ","colab":{"base_uri":"https://localhost:8080/","height":388,"referenced_widgets":["a50289e971d74d0aa868f63c9589bb4e","b40fb35d5cc34d3eb333fe6faf9c35a2","23cddfce13dd489191a