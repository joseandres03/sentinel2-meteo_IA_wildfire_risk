u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1138\u001b[0;31m                 \u001b[0;32mreturn\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_sslobj\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mread\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mlen\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mbuffer\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1139\u001b[0m             \u001b[0;32melse\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1140\u001b[0m                 \u001b[0;32mreturn\u001b[0m \u001b[0mself\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0m_sslobj\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mread\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mlen\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mKeyboardInterrupt\u001b[0m: "]}],"source":["# PRUEBA\n","if __name__ == \"__main__\":\n","\n","    ruta_carpeta = '/content/drive/MyDrive/Master BigData IA/TFM'\n","    ruta_catalogo = os.path.join(ruta_carpeta, \"catalogo_estaciones_canarias.csv\")\n","    df_estaciones = pd.read_csv(ruta_catalogo)\n","    dataset_final = []\n","\n","    for index, fila in tqdm(df_estaciones.iterrows(), total=len(df_estaciones), desc=\"Estaciones\"):\n","        indicativo = fila['indicativo']\n","        lat = fila['latitud_dec']\n","        lon = fila['longitud_dec']\n","\n","        fechas_satelite = calendario_por_estacion(lat, lon)\n","        if not fechas_satelite:\n","            continue\n","\n","        df_meteo_estacion = pd.DataFrame()\n","\n","        for anio in range(ANIO_INICIO, ANIO_FIN + 1):\n","            df_anio = extraer_anio_completo(indicativo, anio)\n","            if not df_anio.empty:\n","                df_meteo_estacion = pd.concat([df_meteo_estacion, df_anio], ignore_index=True)\n","\n","        if df_meteo_estacion.empty:\n","            continue\n","\n","        df_meteo_limpio = limpiar_aemet_reducido(df_meteo_estacion)\n","        df_filtrado = df_meteo_limpio[df_meteo_limpio['fecha'].isin(fechas_satelite)].copy()\n","\n","        if not df_filtrado.empty:\n","            df_filtrado['indicativo'] = indicativo\n","            df_filtrado['nombre'] = fila['nombre']\n","            df_filtrado['provincia'] = fila['provincia']\n","            df_filtrado['latitud_dec'] = lat\n","            df_filtrado['longitud_dec'] = lon\n","\n","            columnas_finales = [\n","                'indicativo', 'nombre', 'provincia', 'latitud_dec', 'longitud_dec',\n","                'fecha', 'tmax', 'hrMedia', 'velmedia'\n","            ]\n","\n","            for col in columnas_finales:\n","                if col not in df_filtrado.columns:\n","                    df_filtrado[col] = pd.NA\n","\n","            dataset_final.append(df_filtrado[columnas_finales])\n","\n","    print(\"\\nEnsamblando el dataset final...\")\n","    if dataset_final:\n","        df_dataset_maestro = pd.concat(dataset_final, ignore_index=True)\n","        df_dataset_maestro.dropna(subset=['tmax', 'hrMedia', 'velmedia'], how='all', inplace=True)\n","\n","        print(f\"¡Éxito! Dataset completado con {len(df_dataset_maestro)} muestras.\")\n","\n","        ruta_dataset = os.path.join(ruta_carpeta, \"dataset_meteo_satelite.csv\")\n","        df_dataset_maestro.to_csv(ruta_dataset, index=False, encoding='utf-8-sig')\n","    else:\n","        print(\"Error: El dataset está vacío. Verifica las descargas.\")"]},{"cell_type":"markdown","metadata":{"id":"GqHpsz3Sq89i"},"source":["Ahora que tenemos el dataset de las medidas de valores meteo por cada estación, solo los días en los que hubo imagen satelital en dicha estación, elaboraré un codigo que asocie a cada observación una imagen 64x64px centrada en la estación de la Aemet correspondiente. Como cada pixel de la imagen satelital tiene 10x10 metros, nuestra imagen 64x64px medirá 640 metros cada lado, lo suficiente para poder visualizar el entorno de la estacion (orografia, tipo de terreno, bosques cercanos, viviendas, etc.). Mas pequeño, por ejemplo 32x32px, nos daria informacion de su entorno mas inmediato, pero no aportaria mucha informacion sobre el contexto espacial. Por otro lado, una imagen mas grande (ej. 256x256px), dada la compleja orografía de las islas y sus acentuados microclimas, el dato meteorologico recogido en el centro de la imagen no sería aplicable a la vegetación situada en los bordes de la imagen. Se estaría asociando una temperatura de 35ºC a un pinar que está a 1.2km ladera arriba que quizás se encuentre a 20ºC bajo la niebla. Por lo que 64x64px es un tamaño optimo.\n","\n","Antes de ejecutar un bucle que realize 40000 iteraciones, haremos una ensayo piloto (unit test)."]},{"cell_type":"code","execution_count":8,"metadata":{"id":"rv_IltRWrsBq","executionInfo":{"status":"ok","timestamp":1787725581760,"user_tz":-60,"elapsed":10,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}}},"outputs":[],"source":["\"\"\"\n","Módulo de extracción de tensores espaciales (Unit Test)\n","Descarga un parche multiespectral de Sentinel-2 centrado en unas coordenadas,\n","lo convierte en matriz matemática (NumPy) y garantiza la dimensión (64, 64, 6).\n","\"\"\"\n","\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","# Definición de las bandas estratégicas (Canales visibles RGB + Infrarojo y SWIR)\n","BANDAS = ['B2', 'B3', 'B4', 'B8', 'B11', 'B12']\n","N_BANDAS = len(BANDAS)\n","TAMANO_PIXELES = 64\n","METROS_POR_PIXEL = 10\n","RADIO_METROS = (TAMANO_PIXELES * METROS_POR_PIXEL) / 2  # 320 metros\n","\n","\n","def extraer_tensor_satelite(lat: float, lon: float, fecha: str) -> np.ndarray:\n","    \"\"\"\n","    Extrae un parche de 64x64 píxeles de Sentinel-2 para una coordenada y fecha.\n","    \"\"\"\n","    punto = ee.Geometry.Point([lon, lat])\n","\n","    # Definimos la ventana geométrica (Bounding Box de 640x640m)\n","    caja_delimitadora = punto.buffer(RADIO_METROS).bounds()\n","    fecha_ee = ee.Date(fecha)\n","\n","    # Consultamos el catálogo de Sentinel-2\n","    coleccion = (\n","        ee.ImageCollection(\"COPERNICUS/S2_SR_HARMONIZED\")\n","        .filterBounds(punto)\n","        .filterDate(fecha_ee, fecha_ee.advance(1, 'day'))\n","        .select(BANDAS)\n","    )\n","\n","    # Extraemos la proyección y escala real (10m) de la primera imagen\n","    imagen_base = coleccion.first()\n","    proyeccion_nativa = imagen_base.select('B2').projection()\n","\n","    # Fusionamos por si hay solapamiento de pasadas ese mismo día\n","    imagen_dia = coleccion.mosaic().setDefaultProjection(proyeccion_nativa)\n","\n","    try:\n","        # Extraemos los datos crudos a nuestro entorno\n","        valores_crudos = imagen_dia.sampleRectangle(region=caja_delimitadora)\n","        info_cruda = valores_crudos.getInfo()\n","\n","        if not info_cruda:\n","            return None\n","\n","        # Construcción del tensor y ajuste dimensional\n","        tensor_perfecto = np.zeros((TAMANO_PIXELES, TAMANO_PIXELES, N_BANDAS), dtype=np.float32)\n","        propiedades = info_cruda.get('properties', {})\n","\n","        for idx, banda in enumerate(BANDAS):\n","            matriz_banda = np.array(propiedades.get(banda))\n","\n","            if matriz_banda.size == 0:\n","                continue\n","\n","            alto_real, ancho_real = matriz_banda.shape\n","\n","            # Recortamos de forma centrada si el satélite devolvió píxeles de más (ej: 65x65)\n","            inicio_y = max(0, (alto_real - TAMANO_PIXELES) // 2)\n","            inicio_x = max(0, (ancho_real - TAMANO_PIXELES) // 2)\n","\n","            fin_y = inicio_y + min(alto_real, TAMANO_PIXELES)\n","            fin_x = inicio_x + min(ancho_real, TAMANO_PIXELES)\n","\n","            recorte = matriz_banda[inicio_y:fin_y, inicio_x:fin_x]\n","\n","            # Insertamos el recorte en nuestro tensor perfecto\n","            alto_recorte, ancho_recorte = recorte.shape\n","            tensor_perfecto[0:alto_recorte, 0:ancho_recorte, idx] = recorte\n","\n","        return tensor_perfecto\n","\n","    except Exception as e:\n","        print(f\"Error en la extracción para {fecha}: {e}\")\n","        return None\n","\n"]},{"cell_type":"code","execution_count":9,"metadata":{"id":"XV3BNvmIzA0F","colab":{"base_uri":"https://localhost:8080/","height":695},"executionInfo":{"status":"ok","timestamp":1787725588628,"user_tz":-60,"elapsed":2606,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}},"outputId":"ba785e2e-4e6c-4755-b4be-8ba7bfbc3309"},"outputs":[{"output_type":"stream","name":"stdout","text":["Iniciando extracción del parche para la estación en [28.089722, -17.111389]...\n","¡Éxito! El tensor matemático se ha extraído correctamente.\n","Estructura dimensional del tensor: (64, 64, 6)\n","\n","Generando visualización RGB...\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 600x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Muestra de los valores de reflectancia (Esquina 3x3 de la Banda B2):\n","[[1116. 1242. 1158.]\n"," [ 913. 1100.  876.]\n"," [ 566.  774.  653.]]\n"]}],"source":["# PRUEBA\n","if __name__ == \"__main__\":\n","\n","    # Simulamos una fila de tu CSV (San Sebastián de La Gomera, C329Z)\n","    LAT_PRUEBA = 28.089722\n","    LON_PRUEBA = -17.111389\n","    FECHA_PRUEBA = \"2021-07-04\"\n","\n","    print(f\"Iniciando extracción del parche para la estación en [{LAT_PRUEBA}, {LON_PRUEBA}]...\")\n","\n","    tensor_resultado = extraer_tensor_satelite(LAT_PRUEBA, LON_PRUEBA, FECHA_PRUEBA)\n","\n","    if tensor_resultado is not None:\n","        print(\"¡Éxito! El tensor matemático se ha extraído correctamente.\")\n","        print(f\"Estructura dimensional del tensor: {tensor_resultado.shape}\")\n","\n","        print(\"\\nGenerando visualización RGB...\")\n","\n","        banda_roja = tensor_resultado[:, :, 2]\n","        banda_verde = tensor_resultado[:, :, 1]\n","        banda_azul = tensor_resultado[:, :, 0]\n","\n","        # Apilamos las 3 matrices para crear una imagen en color real\n","        imagen_rgb = np.dstack((banda_roja, banda_verde, banda_azul))\n","\n","        # Normalizamos la reflectancia de sentinel-2 para visualización óptima\n","        imagen_rgb_normalizada = np.clip(imagen_rgb / 3000.0, 0, 1)\n","\n","        # Dibujamos la imagen\n","        plt.figure(figsize=(6, 6))\n","        plt.imshow(imagen_rgb_normalizada)\n","        plt.title(f\"Parche Satelital RGB (64x64) - {FECHA_PRUEBA}\")\n","        plt.axis('off') # Ocultamos los ejes numéricos\n","        plt.show()\n","\n","        # Mostramos una pequeña muestra matemática (esquina superior izquierda de la banda Azul)\n","        print(\"\\nMuestra de los valores de reflectancia (Esquina 3x3 de la Banda B2):\")\n","        print(tensor_resultado[0:3, 0:3, 0])\n","    else:\n","        print(\"La extracción falló o no hay imagen para esa fecha.\")"]},{"cell_type":"markdown","metadata":{"id":"hZUG6yOgix11"},"source":["Como vemos el test salió correctamente. Ahora procedemos a realizar un bucle que descargue el parche de imagen correspondiente para cada estación meteorológica del DataSet creado previamente."]},{"cell_type":"code","execution_count":null,"metadata":{"id":"FEXjvHT9ji9l","colab":{"base_uri":"https://localhost:8080/","height":101,"referenced_widgets":["77104940e1ce4eb396b1cd47f45775d9","6006bdd966fd46df819bb36e894e71f5","339bc328bdac4aa98a31d0ffa7229220","8e02d460b14443d7996f8111911fca77","ef51bdefc0ef467aade5c793158f0d1a","5fc402defebb4dfdab95b52345343ab4","1fc175ed0a274af59d2791a6fb724cab","8b9864f456ab49aba16fb0e4dab7ef7e","653ae4c28db442fa822cdc50e21f256d","adef1ef14a894b52929bf03b1c07c2c0","d7cf336ccd534e9cbb208d1ea63985ed"]},"outputId":"37f830a9-e020-4ea6-f0ed-2c24709eabd3"},"outputs":[{"output_type":"stream","name":"stdout","text":["Cargando el Dataset maestro meteorológico...\n","\n","Iniciando la 