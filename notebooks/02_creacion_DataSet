 el entrenamiento:\n","  indicativo      tmax  velmedia  Riesgo_Meteo  Riesgo_Combustible  \\\n","0      C018J  0.016949  0.676471      0.182889            0.509740   \n","1      C018J -0.322034  0.088235      0.104000            0.510693   \n","2      C018J -0.067797  0.411765      0.198000            0.510555   \n","3      C018J  0.033898 -0.058824      0.139778            0.486404   \n","4      C018J  0.135593  0.264706      0.177333            0.520381   \n","\n","   Riesgo_Total  \n","0      0.395342  \n","1      0.368351  \n","2      0.401161  \n","3      0.365085  \n","4      0.400314  \n"]}],"source":["\"\"\"\n","EDA y Depuración de datos tabulares (v3)\n","Sincronización, Filtro físico, KNN Imputer, Triple filtro satelital (NDWI + NDVI + NDMI) y Robust Scaler.\n","\"\"\"\n","import joblib\n","from google.colab import drive\n","import os\n","import pandas as pd\n","import numpy as np\n","import warnings\n","from sklearn.impute import KNNImputer\n","from sklearn.preprocessing import RobustScaler\n","from tqdm.notebook import tqdm\n","\n","# Silenciamos la advertencia matemática al promediar cuadrantes que sean 100% océano\n","warnings.filterwarnings('ignore', r'Mean of empty slice')\n","\n","# Conexión con Google Drive\n","drive.mount('/content/drive')\n","\n","# Rutas\n","RUTA_CARPETA_TFM = '/content/drive/MyDrive/Master BigData IA/TFM'\n","RUTA_DATASET_CSV = os.path.join(RUTA_CARPETA_TFM, 'dataset_meteo_satelite.csv')\n","RUTA_CARPETA_TENSORES = os.path.join(RUTA_CARPETA_TFM, 'tensores_satelite')\n","\n","print(\"\\nCargando datos y sincronizando con los tensores satelitales.\")\n","df = pd.read_csv(RUTA_DATASET_CSV)\n","\n","# Creamos la columna con el nombre exacto del archivo esperado\n","df['nombre_tensor'] = df['indicativo'] + '_' + df['fecha'] + '.npy'\n","\n","# Solo nos quedamos con las filas cuyo tensor existe físicamente\n","df['tensor_existe'] = df['nombre_tensor'].apply(lambda x: os.path.exists(os.path.join(RUTA_CARPETA_TENSORES, x)))\n","df_sincronizado = df[df['tensor_existe']].copy()\n","df_sincronizado.drop(columns=['tensor_existe'], inplace=True)\n","\n","print(f\"Muestras iniciales: {len(df)} | Muestras tras purgar imágenes fallidas: {len(df_sincronizado)}\")\n","\n","# EDA\n","variables_meteo = ['tmax', 'hrMedia', 'velmedia']\n","\n","print(\"\\nAplicando filtros...\")\n","# Definición de fronteras absolutas\n","mascara_tmax = (df_sincronizado['tmax'] < -25) | (df_sincronizado['tmax'] > 60)\n","mascara_hr = (df_sincronizado['hrMedia'] < 0) | (df_sincronizado['hrMedia'] > 100)\n","mascara_viento = (df_sincronizado['velmedia'] < 0) | (df_sincronizado['velmedia'] > 250)\n","\n","mascara_total = mascara_tmax | mascara_hr | mascara_viento\n","anomalias_totales = mascara_total.sum()\n","\n","if anomalias_totales > 0:\n","    print(f\"\\nAnomalias detectadas: {anomalias_totales}\")\n","    muestra_anomalias = df_sincronizado[mascara_total]\n","    num_muestras = min(5, anomalias_totales)\n","    print(muestra_anomalias[['fecha', 'indicativo', 'tmax', 'hrMedia', 'velmedia']].sample(num_muestras, random_state=10))\n","else:\n","    print(\"No se detectaron valores atípicos\")\n","\n","# Convertimos los valores físicamente imposibles en NaN\n","df_sincronizado.loc[mascara_tmax, 'tmax'] = np.nan\n","df_sincronizado.loc[mascara_hr, 'hrMedia'] = np.nan\n","df_sincronizado.loc[mascara_viento, 'velmedia'] = np.nan\n","\n","print(\"\\nAplicando KNN Imputer para los valores NaN/nulos...\")\n","df_sincronizado['mes'] = pd.to_datetime(df_sincronizado['fecha']).dt.month\n","columnas_knn = variables_meteo + ['mes']\n","\n","knn_imputer = KNNImputer(n_neighbors=5, weights=\"distance\")\n","estaciones = df_sincronizado['indicativo'].unique()\n","\n","for estacion in estaciones:\n","    mascara_estacion = df_sincronizado['indicativo'] == estacion\n","    df_estacion = df_sincronizado.loc[mascara_estacion, columnas_knn]\n","\n","    if df_estacion[variables_meteo].isna().sum().sum() > 0:\n","        imputado = knn_imputer.fit_transform(df_estacion)\n","        df_sincronizado.loc[mascara_estacion, variables_meteo] = imputado[:, :3]\n","\n","df_sincronizado.drop(columns=['mes'], inplace=True)\n","\n","\n","# Creación de la variable objetivo Riesgo total\n","print(\"\\nCalculando Riesgo Meteorológico...\")\n","R_T = np.clip((df_sincronizado['tmax'] - 15) / 25, 0, 1)\n","R_H = np.clip((80 - df_sincronizado['hrMedia']) / 60, 0, 1)\n","R_V = np.clip(df_sincronizado['velmedia'] / 50, 0, 1)\n","df_sincronizado['Riesgo_Meteo'] = (R_T + R_H + R_V) / 3\n","\n","riesgos_combustible = []\n","\n","# Iteramos sobre todos los archivos para leer el parche completo\n","for archivo in tqdm(df_sincronizado['nombre_tensor'], desc=\"Analizando vegetación\"):\n","    ruta_tensor = os.path.join(RUTA_CARPETA_TENSORES, archivo)\n","    tensor = np.load(ruta_tensor)\n","\n","    # Asignación de bandas según la estructura del satélite\n","    b3_green = tensor[:, :, 1]\n","    b4_red   = tensor[:, :, 2]\n","    b8_nir   = tensor[:, :, 3]\n","    b11_swir = tensor[:, :, 4]\n","\n","    # Filtro de Agua (NDWI)\n","    # Valores > 0.3 son masas de agua. Queremos los <= 0.3 (Tierra).\n","    ndwi_agua = (b3_green - b8_nir) / (b3_green + b8_nir + 1e-8)\n","    es_tierra = ndwi_agua <= 0.3\n","\n","    # Filtro de Roca/Urbano (NDVI)\n","    # Valores bajos (<0.1) son asfalto, roca o suelo desnudo. Queremos > 0.1 (Vegetación/Matorral).\n","    ndvi = (b8_nir - b4_red) / (b8_nir + b4_red + 1e-8)\n","    hay_vegetacion = ndvi > 0.1\n","\n","    # Máscara combinada obligatoria\n","    mascara_valida = es_tierra & hay_vegetacion\n","\n","    # Cálculo de estrés hídrico (NDMI)\n","    ndmi = (b8_nir - b11_swir) / (b8_nir + b11_swir + 1e-8)\n","    riesgo_matriz = np.clip((1 - ndmi) / 2, 0, 1)\n","\n","    # Anulamos todo lo que sea agua o roca\n","    riesgo_matriz[~mascara_valida] = np.nan\n","\n","    # Media exclusiva de la vegetación\n","    if np.isnan(riesgo_matriz).all():\n","        riesgo_veg = 0.0\n","    else:\n","        riesgo_veg = np.nanmean(riesgo_matriz)\n","\n","    riesgos_combustible.append(riesgo_veg)\n","\n","df_sincronizado['Riesgo_Combustible'] = riesgos_combustible\n","\n","print(\"Calculando el riesgo de incendio...\")\n","df_sincronizado['Riesgo_Total'] = (0.35 * df_sincronizado['Riesgo_Meteo']) + (0.65 * df_sincronizado['Riesgo_Combustible'])\n","\n","\n","# Escalado y guardado\n","scaler = RobustScaler()\n","df_sincronizado[variables_meteo] = scaler.fit_transform(df_sincronizado[variables_meteo])\n","\n","ruta_escalador = os.path.join(RUTA_CARPETA_TFM, 'robust_scaler_meteo.pkl')\n","joblib.dump(scaler, ruta_escalador)\n","print(f\"\\nEscalador RobustScaler guardado en:\\n{ruta_escalador}\")\n","\n","ruta_csv_final = os.path.join(RUTA_CARPETA_TFM, 'dataset_final_tfm.csv')\n","df_sincronizado.to_csv(ruta_csv_final, index=False, encoding='utf-8-sig')\n","\n","print(f\"\\nDataset final guardado en:\\n{ruta_csv_final}\")\n","print(\"\\nMuestra de las columnas clave listas para el entrenamiento:\")\n","print(df_sincronizado[['indicativo', 'tmax', 'velmedia', 'Riesgo_Meteo', 'Riesgo_Combustible', 'Riesgo_Total']].head())"]},{"cell_type":"markdown","source":["Mostramos algunos ejemplos visuales para comprobar que el riesgo ahora solo tiene en cuenta los píxeles de vegetación."],"metadata":{"id":"w1RaSBB4wf2x"}},{"cell_type":"code","source":["import numpy as np\n","import matplotlib.pyplot as plt\n","import os\n","from google.colab import drive\n","\n","\n","\n","# Conexión con Google Drive\n","drive.mount('/content/drive')\n","\n","RUTA_CARPETA_TFM = '/content/drive/MyDrive/Master BigData IA/TFM'\n","ruta_tensores = os.path.join(RUTA_CARPETA_TFM, 'tensores_satelite')\n","\n","archivos_prueba = [\n","    {'id': 'C629Q_2024-01-25.npy', 'lugar': 'Mogán (Puerto)'},\n","    {'id': 'C329Z_2025-07-18.npy', 'lugar': 'San Sebastián (Bahía)'}\n","]\n","\n","fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n","\n","for i, datos in enumerate(archivos_prueba):\n","    ruta = os.path.join(ruta_tensores, datos['id'])\n","    tensor = np.load(ruta)\n","\n","    # 1. RGB\n","    rgb = tensor[:, :, :3]\n","    rgb_norm = (rgb - np.min(rgb)) / (np.max(rgb) - np.min(rgb) + 1e-8)\n","\n","    # Bandas\n","    b3_green = tensor[:, :, 1]\n","    b4_red   = tensor[:, :, 2]\n","    b8_nir   = tensor[:, :, 3]\n","    b11_swir = tensor[:, :, 4]\n","\n","    # 2. Triple Filtro\n","    ndwi_agua = (b3_green - b8_nir) / (b3_green + b8_nir + 1e-8)\n","    es_tierra = ndwi_agua <= 0.3\n","\n","    ndvi = (b8_nir - b4_red) / (b8_nir + b4_red + 1e-8)\n","    hay_vegetacion = ndvi > 0.1\n","\n","    mascara_valida = es_tierra & hay_vegetacion\n","\n","    # 3. Cálculo Riesgo NDMI\n","    ndmi = (b8_nir - b11_swir) / (b8_nir + b11_swir + 1e-8)\n","    riesgo_matriz = np.clip((1 - ndmi) / 2, 0, 1)\n","    riesgo_matriz[~mascara_valida] = np.nan # Silenciamos\n","\n","    # PANEL 1: RGB\n","    axes[i, 0].imshow(rgb_norm)\n","    axes[i, 0].set_title(f\"Imagen Real - {datos['lugar']}\", fontsize=12)\n","    axes[i, 0].axis('off')\n","\n","    # PANEL 2: Máscara Combinada (Qué ve el modelo)\n","    # Mostramos en blanco lo que es válido y en negro lo que se ignora\n","    axes[i, 1].imshow(mascara_valida, cmap='gray')\n","    axes[i, 1].set_title(\"Píxeles Válidos (Blanco=Vegetación, Negro=Agua/Roca)\", fontsize=12)\n","    axes[i, 1].axis('off')\n","\n","    # PANEL 3: Mapa de Riesgo Final\n","    cmap_riesgo = plt.cm.RdYlGn_r\n","    cmap_riesgo.set_bad('lightgray', 1.) # Pintamos de gris el fondo ignorado\n","    im = axes[i, 2].imshow(riesgo_matriz, cmap=cmap_riesgo, vmin=0, vmax=1)\n","    axes[i, 2].set_title(f\"Riesgo Combustible (Área útil: {np.mean(mascara_valida)*100:.1f}%)\", fontsize=12)\n","    axes[i, 2].axis('off')\n","\n","# Barra de color global\n","cbar_ax = fig.add_axes([0.92, 0.15, 0.02, 0.7])\n","fig.colorbar(im, cax=cbar_ax, label=\"Riesgo NDMI (0=Húmedo, 1=Seco)\")\n","\n","plt.suptitle(\"VALIDACIÓN DEL TRIPLE FILTRO ESPACIAL (Agua + Ciudad + Estrés Hídrico)\", fontsize=16, fontweight='bold')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":821},"id":"jrf-vEIUbUDg","executionInfo":{"status":"ok","timestamp":1787927389321,"user_tz":-60,"elapsed":102425,"user":{"displayName":"José Andrés Ramos","userId":"02603699963912203172"}},"outputId":"86eb3490-34af-41ff-f532-06b87d908312"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1800x1000 with 7 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["Algunas muestras mas aleatorias"],"metadata":{"id":"Q7ryPZYPcH3d"}},{"cell_type":"code","source":["import pandas as pd\n","\n","\n","RUTA_CARPETA_TFM = '/content/drive/MyDrive/Master BigData IA/TFM'\n","ruta_csv = os.path.join(RUTA_CARPETA_TFM, 'dataset_final_tfm.csv')\n","ruta_tensores = os.path.join(RUTA_CARPETA_TFM, 'tensores_satelite')\n","\n","# Cargar CSV y tomar 3 muestras al azar\n","df = pd.read_csv(ruta_csv)\n","muestras_azar = df.sample(n=3, random_state=None) # Al no tener semilla, cambiarán en cada ejecución\n","\n","fig, axes = plt.subplots(3, 3, figsize=(18, 15))\n","\n","for i, (index, fila) in enumerate(muestras_azar.iterrows()):\n","    archivo = fila['nombre_tensor']\n","    indicativo = fila['indicativo']\n","    fecha = fila['fecha']\n","    ruta = os.path.join(ruta_tensores, archivo)\n","    tensor = np.load(ruta)\n","\n","    # 1. RGB\n","    rgb = tensor[:, :, :3]\n","    rgb_norm = (rgb - np.min(rgb)) / (np.max(rgb) - np.min(rgb) + 1e-8)\n","\n","    # Bandas\n","    b3_green = tensor[:, :, 1]\n","    b4_red   = tensor[:, :, 2]\n","    b8_nir   = tensor[:, :, 3]\n","    b11_swir = tensor[:, :, 4]\n","\n","    # 2. Triple Filtro\n","    ndwi_agua = (b3_green - b8_nir) / (b3_green + b8_nir + 1e-8)\n","    es_tierra = ndwi_agua <= 0.3\n","\n","    ndvi = (b8_nir - b4_red) / (b8_nir + b4_red + 1e-8)\n","